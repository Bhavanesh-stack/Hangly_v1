{
  "name": "hangly",
  "version": "1.0.0",
  "description": "A tiny piece of motion for your desktop. Swings on a simulated rope.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test:physics": "node test/physics.test.js",
    "build:exe": "electron-packager . Hangly --platform=win32 --arch=x64 --out=dist --icon=assets/icons/hangly.ico --overwrite --prune=true"
  },
  "keywords": [
    "desktop-companion",
    "rope-simulation",
    "verlet-physics",
    "hangly",
    "windows"
  ],
  "author": "sharancreatedthis",
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^19.0.3",
    "electron": "^34.3.0"
  }
}
